# 复制为 .env 后填入真实值；.env 已加入 .gitignore，绝不提交到 git
# 在服务器上用 `export $(cat .env | xargs)` 或 systemd EnvironmentFile 注入

# Flask 模式（development / production）
FLASK_ENV=production

# Session 签名密钥：必须 ≥ 32 字节随机串
# 生成方式：python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace-me-with-a-long-random-string

# 后台管理员初始账号（仅首次启动时建库写入一次）
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-me-with-a-strong-password

# 数据库（留空则使用本地 SQLite；生产建议用 PostgreSQL）
# DATABASE_URL=postgresql://user:pass@host:5432/bangqi

# 监控 SSL 证书的域名（仪表盘可随时改，配置仅作初始化默认值）
# SSL_CHECK_HOST=www.bangqi.com
